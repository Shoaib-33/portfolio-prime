[Unit]
Description=Maasland & Partners (website and API)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
User=maasland
WorkingDirectory=/opt/maasland
EnvironmentFile=/etc/maasland.env
ExecStart=/usr/bin/node start.js
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
